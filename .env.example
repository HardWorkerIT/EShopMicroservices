# Copy to .env and replace with a strong, unique password before starting Docker Compose.
DB_PASSWORD=ChangeMe_Use-A-Strong-Password1!
CUSTOMER_DB_PASSWORD=ChangeMe_Customer-Db-Strong-Password3!
ORDER_DB_PASSWORD=ChangeMe_Order-Db-Strong-Password4!
PRODUCT_DB_PASSWORD=ChangeMe_Product-Db-Strong-Password5!
CUSTOMER_MIGRATOR_DB_PASSWORD=ChangeMe_Customer-Migrator-Strong-Password7!
ORDER_MIGRATOR_DB_PASSWORD=ChangeMe_Order-Migrator-Strong-Password8!
PRODUCT_MIGRATOR_DB_PASSWORD=ChangeMe_Product-Migrator-Strong-Password9!
RABBITMQ_PASSWORD=ChangeMe_Use-Another-Strong-Password2!
JWT_SIGNING_KEY=ReplaceWithARandomSecretOfAtLeast32BytesBeforeRunning1!
SERVICE_AUTH_KEY=ReplaceWithAnotherIndependentSecretOfAtLeast32Bytes2!
GRAFANA_ADMIN_PASSWORD=ReplaceWithAStrongGrafanaPassword6!
